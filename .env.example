# Copy to .env (never commit .env; it is already in .gitignore) and fill in real values:
#   cp .env.example .env
# Locally, every lab backend finds this root .env via load_dotenv(); in deployment,
# docker compose passes it to every backend container.

# --- Required -------------------------------------------------------------
OPENAI_API_KEY=

# Secret used by the v8 "Users & Auth" lab to sign login tokens. Use a long random string,
# e.g. the output of: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Deployment (GoDaddy VPS) ----------------------------------------------
# Your domain. The showcase is served at https://$DOMAIN and lab N at https://vN.$DOMAIN.
DOMAIN=example.com
# Email Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=you@example.com

# --- Optional model overrides (each lab has a sensible default) -------------
# OPENAI_MODEL=
# OPENAI_REALTIME_MODEL=
# OPENAI_TEXT_MODEL=
# OPENAI_IMAGE_MODEL=
# OPENAI_CODE_MODEL=
# OPENAI_SECURITY_MODEL=
# OPENAI_USAGE_MODEL=
# OPENAI_TRANSCRIBE_MODEL=
# OPENAI_TTS_MODEL=
